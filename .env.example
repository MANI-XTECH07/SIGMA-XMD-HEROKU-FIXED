# Durable multi-session storage. If set, Baileys credentials and signal keys
# are stored in PostgreSQL rather than the local ./session directory.
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSL=true
DATABASE_POOL_SIZE=5
BOT_API_KEY=replace-with-a-long-random-secret

# Optional local fallback when DATABASE_URL is not set.
SESSION_DIR=./session
